# Copy to .env and fill in as needed. .env is gitignored.

# Supabase Postgres, transaction pooler mode (required for serverless/Vercel —
# see README "Database: Supabase Postgres" for why and for the other modes).
# Get the real value from: Supabase Dashboard -> Project Settings -> Database
# -> Connect -> "Transaction pooler", then append ?pgbouncer=true.
DATABASE_URL="postgresql://postgres.iirbnjkzpzuuofydvhgm:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Server-side only, never entered in the UI (see README "Known trade-offs").
# Settings picks a provider + model; only that provider's key/URL needs to be
# set below. Whichever one is active falls back to a deterministic mock
# provider if unset, so the pipeline stays testable without a live call.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# Ollama isn't a secret (self-hosted), but stays a server env var like the
# above rather than a UI field — it's server-side wiring (which host to call),
# not a per-run product choice. e.g. http://localhost:11434 or an internal host.
OLLAMA_BASE_URL=
